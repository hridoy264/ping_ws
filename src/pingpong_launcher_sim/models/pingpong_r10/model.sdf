    <joint name="head_meter_roller_joint" type="revolute">
      <parent>head_link</parent>
      <child>head_meter_roller_link</child>
      <pose relative_to="head_meter_roller_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <velocity>30</velocity>
          <effort>0.08</effort>
        </limit>
      </axis>
    </joint>
    <joint name="head_meter_motor_joint" type="revolute">
      <parent>head_link</parent>
      <child>head_meter_motor_link</child>
      <pose relative_to="head_meter_motor_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <velocity>30</velocity>
          <effort>0.08</effort>
        </limit>
      </axis>
    </joint>
    <joint name="head_meter_idler_joint" type="revolute">
      <parent>head_meter_idler_carriage_link</parent>
      <child>head_meter_idler_link</child>
      <pose relative_to="head_meter_idler_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <velocity>60</velocity>
          <effort>0.08</effort>
        </limit>
      </axis>
    </joint>
    <joint name="head_meter_idler_slide" type="prismatic">
      <parent>head_link</parent>
      <child>head_meter_idler_carriage_link</child>
      <pose relative_to="head_meter_idler_carriage_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.002</upper>
          <velocity>0.05</velocity>
          <effort>2</effort>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0.02</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="drain_cover_installed_joint" type="fixed">
      <parent>base_link</parent>
      <child>drain_cover_link</child>
      <pose relative_to="drain_cover_link">0 0 0 0 0 0</pose>
    </joint>
    <joint name="drain_service_panel_installed_joint" type="fixed">
      <parent>base_link</parent>
      <child>drain_service_panel_link</child>
      <pose relative_to="drain_service_panel_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>head_meter_roller_joint</joint_name>
      <topic>/pingpong/head_meter_velocity_cmd</topic>
      <use_force_commands>false</use_force_commands>
      <initial_velocity>0</initial_velocity>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>head_meter_motor_joint</joint_name>
      <topic>/pingpong/head_meter_velocity_cmd</topic>
      <use_force_commands>false</use_force_commands>
      <initial_velocity>0</initial_velocity>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>yaw_joint</joint_name>
      <topic>/pingpong/yaw_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <initial_position>0</initial_position>
      <cmd_max>0.6</cmd_max>
      <cmd_min>-0.6</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>pitch_joint</joint_name>
      <topic>/pingpong/pitch_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <initial_position>0</initial_position>
      <cmd_max>0.45</cmd_max>
      <cmd_min>-0.45</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>feeder_joint</joint_name>
      <topic>/pingpong/physical_feeder_velocity_cmd</topic>
