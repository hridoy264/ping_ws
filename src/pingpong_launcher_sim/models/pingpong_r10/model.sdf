    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/pingpong/joint_states</topic>
      <joint_name>yaw_joint</joint_name>
      <joint_name>pitch_joint</joint_name>
      <joint_name>feeder_joint</joint_name>
      <joint_name>wheel_1_joint</joint_name>
      <joint_name>wheel_2_joint</joint_name>
      <joint_name>wheel_3_joint</joint_name>
      <joint_name>head_meter_roller_joint</joint_name>
      <joint_name>head_meter_motor_joint</joint_name>
      <joint_name>head_meter_idler_joint</joint_name>
      <joint_name>head_meter_idler_slide</joint_name>
    </plugin>
    <plugin filename="libpingpong_physical_ball_monitor.so" name="pingpong::PhysicalBallMonitor">
      <head_link>head_link</head_link>
      <muzzle_pose>.220 .060 0 0 0 0</muzzle_pose>
      <aperture_radius>0.045</aperture_radius>
      <ball_name_prefix>inventory_ball_</ball_name_prefix>
      <ball_link>ball_link</ball_link>
      <expected_ball_count>100</expected_ball_count>
      <publish_rate>5</publish_rate>
    </plugin>
  </model>
